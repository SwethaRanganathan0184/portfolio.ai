GROQ_API_KEY=your_groq_api_key_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional — a random secret is generated per-process if you omit this.
# Set it explicitly in production so OAuth "deploy" links survive server
# restarts and work across multiple instances.
JWT_SECRET=a_long_random_string

# Optional — only needed if a site on ANOTHER origin must call this API.
# Comma-separated list. When omitted: local dev allows all origins, while
# production (Vercel, or NODE_ENV=production) allows same-origin only, which
# is all the bundled frontend needs.
# CORS_ORIGIN=https://your-other-site.example

# Optional — overrides the default Groq model used for content/theme generation.
GROQ_MODEL=openai/gpt-oss-120b

# Optional — per-IP request budgets per 15 minutes. Defaults shown.
# RATE_LIMIT_GENERATE_MAX=10
# RATE_LIMIT_API_MAX=30

# Optional — defaults to 3000.
PORT=3000
